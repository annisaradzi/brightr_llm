# Brightr web (Next.js) environment variables.
# Copy to `.env.local` for local development. Do NOT commit `.env.local`.
# For Vercel, set these in Project Settings > Environment Variables.

# --- Required in production ---

# Public HTTPS base URL of the FastAPI backend, no trailing slash.
# Local dev: http://localhost:8000
# Vercel:    https://brightr-api.onrender.com   (or whatever you named it)
INTERNAL_API_URL=http://localhost:8000

# Shared secret. Must match INTERNAL_API_KEY on the FastAPI backend.
# Sent as X-Internal-Key header from the Next.js Route Handlers.
INTERNAL_API_KEY=

# Auth session signing secret. Minimum 16 characters. Used to sign JWT cookies.
AUTH_SECRET=please-change-me-min-16-chars

# JSON map of email -> password for the demo login screen.
# Wrap in single quotes so the shell doesn't choke on the JSON braces.
AUTH_USERS='{"demo@brightr.ai":"changeme"}'
