# Brightr backend environment variables.
# Copy this file to `.env` for local development. Do NOT commit `.env`.

# --- Required ---

# Google Gemini API key. https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Shared secret enforced by the FastAPI server when set. Must match the value
# you set on the Next.js (Vercel) side as INTERNAL_API_KEY. Leave blank for
# fully-open local dev, set in any deployed environment.
INTERNAL_API_KEY=

# --- Optional (sensible defaults shown) ---

# Gemini model id. Change to override the default used by analysis_service.py.
GEMINI_MODEL=gemini-3-flash-preview

# Database URL. Default is a local SQLite file in the working directory.
# On Render, set to: sqlite:////data/brightr.db (note the 4 slashes for /data).
DATABASE_URL=sqlite:///./brightr.db

# Storage root for uploaded JPEGs, sidecars, and generated PDFs.
# On Render, set to /data/storage so it lands on the persistent disk.
STORAGE_ROOT=storage

# Comma-separated browser origins the FastAPI CORS middleware allows.
# Only matters if you call FastAPI directly from a browser; production traffic
# goes server-to-server through the Next.js proxy and ignores CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
